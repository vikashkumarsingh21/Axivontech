generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  portfolioProjects PortfolioProject[]
}

model User {
  createdCommissionRules CommissionRule[] @relation("CommissionRuleCreator")
  approvedCommissions    Commission[]     @relation("CommissionApprover")
  paidCommissions        Commission[]     @relation("CommissionPayer")
  id                     String           @id @default(cuid())
  email                  String           @unique
  name                   String
  passwordHash           String
  phone                  String?
  avatarUrl              String?
  employeeId             String?          @unique
  department             String?
  designation            String?
  address                String?
  emergencyContact       String?
  status                 String           @default("ACTIVE")
  inactiveAt             DateTime?
  requiredDailyMinutes   Int              @default(480)
  joiningDate            DateTime         @default(now())

  mustChangePassword     Boolean          @default(false)
  activationToken        String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  sessions       Session[]
  auditLogs      AuditLog[]

  // Roles and Permissions
  userRoles UserRole[]

  // Phase 2: Employee Portal Relations
  attendances             Attendance[]
  tasks                   Task[]
  taskComments            TaskComment[]
  workReports             WorkReport[]
  leaveRequests           LeaveRequest[]
  regularizations         RegularizationRequest[]
  reviewedRegularizations RegularizationRequest[] @relation("RegularizationReviewer")
  notifications           Notification[]
  uploadedDocs            Document[]              @relation("DocumentUploader")
  projectMembers          ProjectMember[]

  // Phase 4: Executive Relations
  executiveProfile   ExecutiveProfile?
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  decidedApprovals   ApprovalRequest[] @relation("ApprovalDecider")
  securityEvents     SecurityEvent[]

  // Phase 6: Shared System Relations
  reminders            Reminder[]
  createdAutomations   AutomationWorkflow[]
  userPreference       UserPreference?
  activities           Activity[]           @relation("ActivityActor")
  createdAnnouncements Announcement[]       @relation("AnnouncementCreator")
  uploadedDocVersions  DocumentVersion[]    @relation("VersionUploader")
  documentPermissions  DocumentPermission[] @relation("UserDocumentPermissions")

  // Phase 5: CRM Relations
  ownedLeads               Lead[]              @relation("LeadOwner")
  qualifiedLeads           Lead[]              @relation("LeadQualifier")
  convertedLeads           Lead[]              @relation("LeadConverter")
  leadActivities           LeadActivity[]      @relation("ActivityActor")
  assignedFollowUps        FollowUp[]          @relation("FollowUpAssignee")
  ownedOpportunities       Opportunity[]       @relation("OpportunityOwner")
  createdProposals         Proposal[]          @relation("ProposalCreator")
  knowledgeCreated         KnowledgeDocument[] @relation("KnowledgeCreator")
  knowledgeUpdated         KnowledgeDocument[] @relation("KnowledgeUpdater")
  ownedClients             CrmClient[]         @relation("ClientOwner")
  createdPortfolioProjects PortfolioProject[]  @relation("PortfolioCreator")
  leadNotes                LeadNote[]          @relation("LeadNoteAuthor")
  leadMeetings             LeadMeeting[]       @relation("LeadMeetingCreator")

  // Broker Relations
  brokerProfile BrokerProfile?

  // Partner System Relations
  uploadedPartnerDocuments PartnerDocument[] @relation("PartnerDocumentUploader")
  paymentSettingsUpdated   PaymentSettings[] @relation("PaymentSettingsUpdater")

  // Business Partner Application Relations
  reviewedApplications       BusinessPartnerApplication[] @relation("ApplicationReviewer")
  createdApplicationMeetings ApplicationMeeting[]         @relation("ApplicationMeetingCreator")
  changedApplicationStatuses ApplicationStatusHistory[]     @relation("ApplicationStatusChanger")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrokerProfile {
  commissions  Commission[]
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode String?      @unique
  partnerId    String?      @unique

  companyName String?
  designation String?
  whatsapp    String?
  city        String?
  state       String?
  country     String?
  website     String?

  // Relations
  partnerDocuments PartnerDocument[]
  partnerProjects  PartnerProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralCode])
}

// Confirmed Project Onboarding submitted by Broker client via /project/start/[referralCode]
model PartnerProject {
  commission      Commission?
  id              String        @id @default(cuid())
  projectCode     String        @unique
  brokerProfileId String
  brokerProfile   BrokerProfile @relation(fields: [brokerProfileId], references: [id], onDelete: Cascade)

  // Client details (collected from public form — never trust from browser)
  clientName        String
  clientEmail       String
  clientPhone       String
  clientWhatsapp    String?
  clientDesignation String?

  // Company details
  companyName     String
  industry        String
  businessAddress String?
  city            String
  state           String
  country         String
  website         String?
  companySize     String?
  gstNumber       String?
  regNumber       String?

  // Project details
  projectName            String
  requiredService        String
  detailedRequirement    String  @db.Text
  expectedTimeline       String
  projectBudget          String
  finalProjectValue      Float?
  additionalRequirements String?

  // Primary contact
  contactPerson String?
  contactEmail  String?
  contactPhone  String?

  // Status
  status String @default("PROJECT_REQUESTED")
  // PROJECT_REQUESTED, REVIEWING, DISCUSSION, PROPOSAL_SENT, NEGOTIATION,
  // CONTRACT_SENT, CONTRACT_SIGNED, PAYMENT_PENDING, PAYMENT_SUBMITTED,
  // PAYMENT_VERIFICATION, PROJECT_CONFIRMED, IN_PROGRESS, COMPLETED,
  // CANCELLED, REJECTED

  // Internal notes (admin only — never sent to broker)
  adminNotes String?

  // Relations
  contract  PartnerContract?
  payment   PartnerPayment?
  documents PartnerDocument[]

  // Linked to existing CRM Lead/Opportunity if converted
  leadId        String? @unique
  convertedFromLead Lead? @relation("LeadToProject", fields: [leadId], references: [id], onDelete: SetNull)
  opportunityId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerProfileId])
  @@index([status])
  @@index([projectCode])
}

// Documents shared by Admin/Founder to Brokers
model PartnerDocument {
  id          String    @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  storageKey  String?
  mimeType    String?
  sizeBytes   Int?
  category    String    @default("GENERAL")
  // GENERAL, COMPANY_INFO, PARTNER_GUIDELINES, MARKETING, PRICING, SERVICE_INFO, CONTRACT, PROJECT_DOCS, IMPORTANT_NOTICE
  isImportant Boolean   @default(false)
  expiresAt   DateTime?

  // Who uploaded
  uploadedById String
  uploadedBy   User   @relation("PartnerDocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  // Targeting: if brokerProfileId is null → shared with ALL brokers
  brokerProfileId String?
  brokerProfile   BrokerProfile? @relation(fields: [brokerProfileId], references: [id], onDelete: Cascade)

  // Optionally linked to a specific project
  partnerProjectId String?
  partnerProject   PartnerProject? @relation(fields: [partnerProjectId], references: [id], onDelete: SetNull)

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerProfileId])
  @@index([partnerProjectId])
  @@index([category])
}

// Contract root for a confirmed project
model PartnerContract {
  id               String         @id @default(cuid())
  partnerProjectId String         @unique
  partnerProject   PartnerProject @relation(fields: [partnerProjectId], references: [id], onDelete: Cascade)
  
  status           String         @default("SENT") // LATEST status: NOT_SENT, SENT, DOWNLOADED, SIGNED, UNDER_REVIEW, VERIFIED, REJECTED, REUPLOAD_REQUIRED
  
  versions         PartnerContractVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contract Version / Historical Evidence
model PartnerContractVersion {
  id                String          @id @default(cuid())
  partnerContractId String
  partnerContract   PartnerContract @relation(fields: [partnerContractId], references: [id], onDelete: Cascade)
  
  versionNumber     Int

  // Sent contract (by Admin/Founder)
  contractName        String
  contractDescription String?
  contractFileUrl     String
  contractStorageKey  String?
  sentAt              DateTime @default(now())
  sentById            String

  // Signed contract (uploaded by Broker/client)
  signedFileUrl    String?
  signedStorageKey String?
  stampFileUrl     String?
  stampStorageKey  String?
  signedAt         DateTime?
  signingConfirmed Boolean   @default(false)

  // Admin verification for this specific version
  status          String    @default("SENT")
  // SENT, DOWNLOADED, SIGNED, UNDER_REVIEW, VERIFIED, REJECTED, REUPLOAD_REQUIRED, SUPERSEDED
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?
  rejectedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerContractId])
  @@index([status])
}

// Payment for a confirmed project
model PartnerPayment {
  id               String         @id @default(cuid())
  partnerProjectId String         @unique
  partnerProject   PartnerProject @relation(fields: [partnerProjectId], references: [id], onDelete: Cascade)

  // Calculated amounts
  projectPrice      Float
  advancePercentage Int    @default(40)
  advanceAmount     Float
  remainingAmount   Float
  currency          String @default("INR")

  // Payment settings snapshot at time of payment request (versioning)
  paymentSettingsSnapshot Json?

  // Proof submitted by Broker/client
  paymentMethod   String? // BANK | UPI
  amountPaid      Float?
  transactionId   String?
  paymentDate     DateTime?
  proofFileUrl    String?
  proofStorageKey String?
  additionalNotes String?

  // Status
  status String @default("PENDING")
  // PENDING, SUBMITTED, UNDER_REVIEW, VERIFIED, REJECTED

  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?
  rejectedAt      DateTime?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Payment Settings (bank + UPI), versioned via snapshot on payment creation
model PaymentSettings {
  id       String  @id @default(cuid())
  type     String // BANK | UPI
  isActive Boolean @default(true)

  // Bank details
  accountHolderName String?
  bankName          String?
  accountNumber     String?
  ifscCode          String?
  branch            String?
  accountType       String? // SAVINGS | CURRENT

  // UPI details
  upiId     String?
  upiName   String?
  qrCodeUrl String?

  updatedById String?
  updatedBy   User?   @relation("PaymentSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique // e.g., "users:read", "users:write"
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// PHASE 2: EMPLOYEE PORTAL MODELS
// -----------------------------------------------------------------------------

model Attendance {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                 DateTime  @db.Date
  checkInAt            DateTime
  checkOutAt           DateTime?
  grossMinutes         Int?      @default(0)
  breakMinutes         Int?      @default(0)
  netMinutes           Int?      @default(0)
  totalMinutes         Int? // Legacy alias for netMinutes
  requiredDailyMinutes Int?      @default(480)
  remainingMinutes     Int?      @default(0)
  lateMinutes          Int?      @default(0)
  earlyExitMinutes     Int?      @default(0)
  isLate               Boolean   @default(false)
  isEarlyExit          Boolean   @default(false)
  status               String    @default("PRESENT") // PRESENT, HALF_DAY, LATE, NOT_STARTED, IN_PROGRESS, COMPLETE, INCOMPLETE, ABSENT, ON_LEAVE, HOLIDAY, WEEKLY_OFF
  completionStatus     String    @default("INCOMPLETE") // COMPLETE, INCOMPLETE, ON_LEAVE, HOLIDAY, WEEKLY_OFF, HALF_DAY
  emailAlertSent       Boolean   @default(false)
  notes                String?

  breaks         AttendanceBreak[]
  regularization RegularizationRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // Prevent duplicate attendance for the same day
  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([completionStatus])
}

model AttendanceBreak {
  id              String     @id @default(cuid())
  attendanceId    String
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?       @default(0)
  type            String     @default("LUNCH") // LUNCH, TEA, PERSONAL, SHORT_BREAK, OTHER
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attendanceId])
}

model AttendancePolicy {
  id                        String  @id @default(cuid())
  workWindowStart           String  @default("08:00") // 08:00 AM
  workWindowEnd             String  @default("19:00") // 07:00 PM
  defaultRequiredMinutes    Int     @default(480) // 8 Hours = 480 Mins
  graceMinutes              Int     @default(15)
  cutoffTime                String  @default("19:00") // 07:00 PM
  weeklyOffDays             Json? // e.g. [0, 6] (Sunday, Saturday)
  enableIncompleteAlerts    Boolean @default(true)
  allowRemoteRegularization Boolean @default(true)
  updatedById               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegularizationRequest {
  id                String      @id @default(cuid())
  attendanceId      String?     @unique
  attendance        Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime    @db.Date
  requestedCheckIn  DateTime
  requestedCheckOut DateTime
  requestedBreaks   Json?
  reason            String
  status            String      @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  reviewedById      String?
  reviewedBy        User?       @relation("RegularizationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes       String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([date])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @unique @db.Date
  isOptional  Boolean  @default(false)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status       String    @default("TODO") // TODO, IN_PROGRESS, BLOCKED, COMPLETED
  dueDate      DateTime?
  assignedDate DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model TaskComment {
  id      String @id @default(cuid())
  content String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

model WorkReport {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  summary        String
  tasksCompleted String?
  workPerformed  String
  challenges     String?
  nextSteps      String?
  hoursWorked    Float?

  status String @default("SUBMITTED") // SUBMITTED, REVIEWED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model LeaveRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveType String // SICK, CASUAL, ANNUAL, UNPAID
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String

  status String @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       String // TASK_ASSIGNED, TASK_UPDATED, LEAVE_UPDATED, WORK_REPORT_REVIEWED, NEW_LEAD, FOLLOW_UP_DUE, PROPOSAL_UPDATED, ANNOUNCEMENT, DOCUMENT_SHARED, SECURITY_EVENT, SYSTEM_EVENT
  title      String
  message    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  link       String? // Optional URL to redirect to
  entityType String?
  entityId   String?
  priority   String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  dedupKey   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([dedupKey])
}

model Announcement {
  id            String    @id @default(cuid())
  title         String
  content       String
  priority      String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status        String    @default("PUBLISHED") // DRAFT, SCHEDULED, PUBLISHED, ARCHIVED, EXPIRED
  audienceType  String    @default("ALL") // ALL, DEPARTMENT, ROLE, PROJECT, USERS
  audienceScope String? // department name, role name, project id, or json array
  publishAt     DateTime  @default(now())
  publishedAt   DateTime  @default(now())
  expiresAt     DateTime?

  createdById String?
  createdBy   User?   @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@index([status])
  @@index([audienceType])
}

model Document {
  id              String  @id @default(cuid())
  title           String
  description     String?
  category        String // COMPANY_POLICY, GUIDELINE, FORM, HR_DOCUMENT, PROJECT_DOCUMENT, CLIENT_DOCUMENT, TEMPLATE, INTERNAL_RESOURCE
  fileUrl         String
  storageKey      String?
  mimeType        String?
  size            Int?
  visibility      String  @default("COMPANY") // COMPANY, DEPARTMENT, ROLE, PROJECT, PRIVATE, USERS
  visibilityScope String?
  currentVersion  Int     @default(1)
  isArchived      Boolean @default(false)

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  versions    DocumentVersion[]
  permissions DocumentPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([visibility])
  @@index([uploadedById])
  @@index([isArchived])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ON_HOLD
  startDate   DateTime?
  endDate     DateTime?

  members ProjectMember[]
  tasks   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  projectId String
  userId    String
  role      String @default("MEMBER") // MANAGER, MEMBER

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

// -----------------------------------------------------------------------------
// PHASE 4: EXECUTIVE & GOVERNANCE MODELS
// -----------------------------------------------------------------------------

model ExecutiveProfile {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  responsibilityProfile String // TECHNOLOGY, OPERATIONS, BUSINESS_GROWTH, FULL
  departmentScope       String? // Optional JSON array or comma-separated string
  projectScope          String? // Optional JSON array or comma-separated string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalRequest {
  id            String @id @default(cuid())
  requestType   String // HIGH_PRIVILEGE_ROLE_ASSIGNMENT, SENSITIVE_PERMISSION_CHANGE, EMPLOYEE_STATUS_EXCEPTION, HIGH_IMPACT_PROJECT_CHANGE, SENSITIVE_EXPORT, ORGANIZATIONAL_SETTING_CHANGE
  requestedById String
  requestedBy   User   @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  decidedById String?
  decidedBy   User?   @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  status   String  @default("PENDING") // PENDING, APPROVED, REJECTED
  reason   String?
  metadata Json?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([status])
  @@index([requestedById])
}

model SecurityEvent {
  id        String  @id @default(cuid())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String // LOGIN_SUCCESS, LOGIN_FAILED, ROLE_CHANGED, PERMISSION_CHANGED, SENSITIVE_EXPORT, SUSPICIOUS_ACCESS
  ipAddress String?
  userAgent String?
  details   Json?

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model OrganizationSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  updatedById String?

  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// PHASE 6: SHARED ADVANCED INFRASTRUCTURE MODELS
// -----------------------------------------------------------------------------

model EmailLog {
  id          String  @id @default(cuid())
  toEmail     String
  templateKey String
  subject     String
  status      String  @default("SENT") // SENT, FAILED
  error       String?
  metadata    Json?

  sentAt DateTime @default(now())

  @@index([toEmail])
  @@index([templateKey])
}

model EmailTemplate {
  id        String  @id @default(cuid())
  key       String  @unique
  subject   String
  htmlBody  String
  textBody  String
  variables Json? // Array of allowed variable names
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reminder {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    @default("CUSTOM") // TASK, LEAVE, APPROVAL, DOCUMENT, CUSTOM
  title         String
  description   String?
  dueAt         DateTime
  status        String    @default("PENDING") // PENDING, COMPLETED
  relatedEntity Json?
  completedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([dueAt])
  @@index([status])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  jobType     String // NOTIFICATION_SEND, EMAIL_RETRY, REMINDER_DELIVERY, ANNOUNCEMENT_SCHEDULE, DOCUMENT_EXPIRY
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  payload     Json?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([jobType])
}

model AutomationWorkflow {
  id          String  @id @default(cuid())
  name        String
  triggerType String // TASK_OVERDUE, LEAVE_SUBMITTED, DOCUMENT_EXPIRING
  conditions  Json?
  actions     Json?
  isActive    Boolean @default(true)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  executions AutomationExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationExecution {
  id           String             @id @default(cuid())
  automationId String
  automation   AutomationWorkflow @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggerEvent String
  status       String             @default("SUCCESS") // SUCCESS, FAILED
  dedupKey     String?
  result       Json?

  executedAt DateTime @default(now())

  @@index([automationId])
  @@index([dedupKey])
}

model UserPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean @default(true)
  inAppNotifications Boolean @default(true)
  timezone           String  @default("UTC")
  theme              String  @default("dark")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// PHASE 5: CRM & LEAD MANAGEMENT MODELS
// -----------------------------------------------------------------------------

model Lead {
  id                  String  @id @default(cuid())
  leadCode            String  @unique
  name                String
  email               String
  phone               String?
  whatsapp            String?
  designation         String?
  companyName         String?
  industry            String?
  city                String?
  state               String?
  country             String?
  companySize         String?
  website             String?
  serviceInterest     String?
  message             String?
  source              String  @default("WEBSITE_CONTACT") // WEBSITE_CONTACT, CONSULTATION, REFERRAL, SOCIAL_MEDIA, CAMPAIGN, MANUAL, PARTNER, OTHER
  campaign            String?
  status              String  @default("NEW") // NEW, CONTACTED, MEETING, QUALIFIED, NOT_QUALIFIED, CONVERTED, LOST, NURTURE
  qualificationStatus String  @default("UNQUALIFIED") // QUALIFIED, UNQUALIFIED, IN_PROGRESS

  // Qualification Details
  budget             Float?
  timeline           String?
  businessNeed       String?
  decisionMakerKnown Boolean @default(false)
  qualificationNotes String?

  // Duplicate Tracking
  isDuplicate     Boolean @default(false)
  duplicateReason String?

  // Follow-up Tracking
  nextFollowUpAt DateTime?
  lastContactAt  DateTime?

  // Qualification Tracking
  qualifiedAt       DateTime?
  qualifiedByUserId String?
  qualifiedByUser   User?    @relation("LeadQualifier", fields: [qualifiedByUserId], references: [id], onDelete: SetNull)

  // Conversion Tracking
  convertedAt       DateTime?
  convertedByUserId String?
  convertedByUser   User?    @relation("LeadConverter", fields: [convertedByUserId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  convertedClientId String?
  convertedClient   CrmClient? @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)

  // Relations
  activities       LeadActivity[]
  followUps        FollowUp[]
  opportunities    Opportunity[]
  notes            LeadNote[]
  meetings         LeadMeeting[]
  convertedProject PartnerProject? @relation("LeadToProject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([email])
  @@index([leadCode])
  @@index([qualifiedByUserId])
  @@index([convertedByUserId])
}

model LeadActivity {
  id            String       @id @default(cuid())
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  clientId      String?
  client        CrmClient?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  type     String // LEAD_CREATED, LEAD_ASSIGNED, STATUS_CHANGED, NOTE_ADDED, CALL_RECORDED, MEETING_RECORDED, FOLLOWUP_CREATED, FOLLOWUP_COMPLETED, OPPORTUNITY_CREATED, PROPOSAL_SENT, DEAL_WON, DEAL_LOST, CLIENT_CONVERTED
  title    String
  notes    String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([opportunityId])
  @@index([clientId])
  @@index([actorId])
}

model FollowUp {
  id            String       @id @default(cuid())
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  clientId      String?
  client        CrmClient?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  dueAt       DateTime
  type        String    @default("CALL") // CALL, EMAIL, MEETING, WHATSAPP, DEMO, PROPOSAL_FOLLOWUP, GENERAL
  notes       String?
  status      String    @default("UPCOMING") // UPCOMING, DUE, OVERDUE, COMPLETED
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([status])
  @@index([dueAt])
}

// Phase 5: Internal notes on leads (with visibility control)
model LeadNote {
  id         String @id @default(cuid())
  leadId     String
  lead       Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User   @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content    String @db.Text
  visibility String @default("INTERNAL") // INTERNAL, PARTNER_VISIBLE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([authorId])
}

// Phase 5: Meeting records for lead qualification
model LeadMeeting {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  type         String    @default("VIRTUAL") // VIRTUAL, IN_PERSON, PHONE
  participants String?
  outcome      String?
  nextAction   String?
  followUpDate DateTime?
  notes        String?   @db.Text
  createdById  String
  createdBy    User      @relation("LeadMeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([createdById])
}

model PipelineStage {
  id          String  @id @default(cuid())
  name        String
  key         String  @unique // QUALIFIED, DISCOVERY, PROPOSAL, NEGOTIATION, WON, LOST
  order       Int     @default(0)
  probability Int     @default(50)
  description String?

  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id              String     @id @default(cuid())
  opportunityCode String     @unique
  leadId          String?
  lead            Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId        String?
  client          CrmClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name              String
  description       String?
  value             Float     @default(0)
  currency          String    @default("INR")
  probability       Int       @default(50)
  expectedCloseDate DateTime?
  stage             String    @default("QUALIFIED") // QUALIFIED, DISCOVERY, PROPOSAL, NEGOTIATION, WON, LOST

  stageId       String?
  pipelineStage PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  lossReason String?

  proposals  Proposal[]
  activities LeadActivity[]
  followUps  FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([leadId])
  @@index([clientId])
  @@index([stage])
}

model Proposal {
  id             String      @id @default(cuid())
  proposalNumber String      @unique
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  title             String
  amount            Float
  currency          String    @default("INR")
  status            String    @default("DRAFT") // DRAFT, READY, SENT, ACCEPTED, REJECTED, EXPIRED
  sentAt            DateTime?
  validUntil        DateTime?
  documentReference String?

  createdById String?
  createdBy   User?   @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId])
  @@index([status])
}

model CrmClient {
  id          String  @id @default(cuid())
  clientCode  String  @unique
  companyName String
  contactName String
  email       String
  phone       String?
  website     String?
  industry    String?
  status      String  @default("ACTIVE") // ACTIVE, INACTIVE, ONBOARDING

  ownerId String?
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  leads         Lead[]
  opportunities Opportunity[]
  activities    LeadActivity[]
  followUps     FollowUp[]
  contacts      ClientContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([email])
  @@index([clientCode])
}

model ClientContact {
  id       String    @id @default(cuid())
  clientId String
  client   CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// -----------------------------------------------------------------------------
// PHASE 6: ADVANCED COMMUNICATION & DOCUMENT EXPANSIONS
// -----------------------------------------------------------------------------

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int     @default(1)
  fileUrl       String
  storageKey    String?
  size          Int?
  mimeType      String?
  changeNotes   String?

  uploadedById String
  uploadedBy   User   @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
}

model DocumentPermission {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?   @relation("UserDocumentPermissions", fields: [userId], references: [id], onDelete: Cascade)
  role        String? // FOUNDER, CO_FOUNDER, ADMIN, EMPLOYEE
  accessLevel String  @default("VIEW") // VIEW, EDIT, ADMIN

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([userId])
}

model Activity {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String // CREATED, UPDATED, DELETED, ASSIGNED, APPROVED, REJECTED, PUBLISHED, ARCHIVED, UPLOADED, EXPORTED, CONVERTED
  entityType String // TASK, LEAVE, REPORT, PROJECT, ANNOUNCEMENT, DOCUMENT, LEAD, OPPORTUNITY, CLIENT, USER, SYSTEM
  entityId   String?
  summary    String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model CommunicationTemplate {
  id        String  @id @default(cuid())
  key       String  @unique
  category  String  @default("EMAIL") // EMAIL, NOTIFICATION, ANNOUNCEMENT, REPORT
  name      String
  subject   String?
  content   String
  variables Json? // Array of allowed variable names
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([key])
}

// -----------------------------------------------------------------------------
// AI CHATBOT: KNOWLEDGE BASE MODELS  
// -----------------------------------------------------------------------------

model KnowledgeDocument {
  id              String   @id @default(cuid())
  title           String
  category        String   @default("COMPANY") // COMPANY, SERVICES, PROCESS, PRICING, FAQ, PORTFOLIO, TECHNOLOGY, CONTACT, INDUSTRIES
  sourceType      String   @default("MANUAL") // MANUAL, WEBSITE_PAGE, DOCUMENT
  sourceReference String?
  content         String   @db.Text
  status          String   @default("DRAFT") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  version         Int      @default(1)
  tags            String[]

  createdById String?
  createdBy   User?   @relation("KnowledgeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("KnowledgeUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdById])
}

model ChatKnowledgeGap {
  id         String    @id @default(cuid())
  question   String
  intent     String    @default("UNKNOWN")
  frequency  Int       @default(1)
  status     String    @default("OPEN") // OPEN, ADDRESSED, IGNORED
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([intent])
}

model ChatFeedback {
  id             String  @id @default(cuid())
  conversationId String
  rating         String // HELPFUL, NOT_HELPFUL
  comment        String?
  messageContent String?

  createdAt DateTime @default(now())

  @@index([rating])
  @@index([conversationId])
}

// -----------------------------------------------------------------------------
// PHASE 7: PORTFOLIO CMS MODELS
// -----------------------------------------------------------------------------

model PortfolioProject {
  id               String        @id @default(cuid())
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  slug             String        @unique
  title            String
  category         String
  industry         String
  shortDescription String
  fullDescription  String        @db.Text
  problem          String        @db.Text
  solution         String        @db.Text
  features         String[]
  technologies     String[]
  client           String?
  liveUrl          String?
  githubUrl        String?
  thumbnail        String
  heroImage        String
  gallery          String[]

  status       String  @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  featured     Boolean @default(false)
  displayOrder Int     @default(0)

  seoTitle       String?
  seoDescription String?

  createdById String?
  createdBy   User?   @relation("PortfolioCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  @@index([status])
  @@index([slug])
  @@index([organizationId])
  @@index([featured])
}

// -----------------------------------------------------------------------------
// PHASE 2: COMMISSION ENGINE MODELS
// -----------------------------------------------------------------------------

model CommissionRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  value       Float
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("CommissionRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  commissions Commission[]
}

model Commission {
  id               String         @id @default(cuid())
  partnerProjectId String         @unique
  partnerProject   PartnerProject @relation(fields: [partnerProjectId], references: [id], onDelete: Cascade)
  brokerProfileId  String
  brokerProfile    BrokerProfile  @relation(fields: [brokerProfileId], references: [id], onDelete: Cascade)

  commissionRuleId String?
  commissionRule   CommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)

  projectValue     Float
  commissionType   String @default("PERCENTAGE")
  commissionRate   Float?
  commissionAmount Float
  currency         String @default("INR")

  status String @default("PENDING")
  // PENDING, ELIGIBLE, APPROVED, PROCESSING, PAID, CANCELLED, REJECTED

  eligibleAt   DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("CommissionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  paidAt   DateTime?
  paidById String?
  paidBy   User?     @relation("CommissionPayer", fields: [paidById], references: [id], onDelete: SetNull)

  notes           String?
  payoutReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerProfileId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// PHASE 2: BUSINESS PARTNER APPLICATION MODELS
// -----------------------------------------------------------------------------

model BusinessPartnerApplication {
  id                 String   @id @default(cuid())
  applicationId      String   @unique
  
  fullName           String
  email              String   @unique
  phone              String
  country            String
  state              String?
  city               String

  occupation         String
  currentWork        String?
  yearsOfExperience  Int?
  relevantExperience String?  @db.Text
  clientNetwork      String?  @db.Text

  education10th      Json     
  education12th      Json?    
  educationUndergrad Json?  

  motivation         String?  @db.Text
  contribution       String?  @db.Text
  additionalInfo     String?  @db.Text

  emailVerifiedAt    DateTime?
  verificationToken  String?

  status             String   @default("SUBMITTED") 
  decisionReason     String?  @db.Text

  reviewedById       String?
  reviewedBy         User?    @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  
  reviewedAt         DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  meetings           ApplicationMeeting[]
  statusHistory      ApplicationStatusHistory[]

  @@index([status])
  @@index([email])
}

model ApplicationMeeting {
  id               String                     @id @default(cuid())
  applicationId    String
  application      BusinessPartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  meetingDate      DateTime
  durationMinutes  Int       @default(30)
  meetingType      String    @default("ONLINE") 
  locationOrLink   String?
  status           String    @default("SCHEDULED") 
  notes            String?   @db.Text

  createdById      String?
  createdBy        User?     @relation("ApplicationMeetingCreator", fields: [createdById], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([applicationId])
  @@index([status])
}

model ApplicationStatusHistory {
  id               String                     @id @default(cuid())
  applicationId    String
  application      BusinessPartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  previousStatus   String?
  newStatus        String
  reason           String?    @db.Text
  
  changedById      String?
  changedBy        User?      @relation("ApplicationStatusChanger", fields: [changedById], references: [id])

  createdAt        DateTime   @default(now())

  @@index([applicationId])
}

