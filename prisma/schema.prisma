generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String
  passwordHash     String
  phone            String?
  avatarUrl        String?
  employeeId       String?       @unique
  department       String?
  designation      String?
  address          String?
  emergencyContact String?
  status           String        @default("ACTIVE")
  inactiveAt       DateTime?
  requiredDailyMinutes Int       @default(480)
  joiningDate      DateTime      @default(now())

  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  sessions         Session[]
  auditLogs        AuditLog[]

  // Roles and Permissions
  userRoles        UserRole[]
  
  // Phase 2: Employee Portal Relations
  attendances      Attendance[]
  tasks            Task[]
  taskComments     TaskComment[]
  workReports      WorkReport[]
  leaveRequests    LeaveRequest[]
  notifications    Notification[]
  uploadedDocs     Document[]     @relation("DocumentUploader")
  projectMembers   ProjectMember[]

  // Phase 4: Executive Relations
  executiveProfile   ExecutiveProfile?
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  decidedApprovals   ApprovalRequest[] @relation("ApprovalDecider")
  securityEvents     SecurityEvent[]

  // Phase 6: Shared System Relations
  reminders          Reminder[]
  createdAutomations AutomationWorkflow[]
  userPreference     UserPreference?

  // Phase 5: CRM Relations
  ownedLeads         Lead[]         @relation("LeadOwner")
  leadActivities     LeadActivity[] @relation("ActivityActor")
  assignedFollowUps  FollowUp[]     @relation("FollowUpAssignee")
  ownedOpportunities Opportunity[]  @relation("OpportunityOwner")
  createdProposals   Proposal[]     @relation("ProposalCreator")
  ownedClients       CrmClient[]    @relation("ClientOwner")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "users:read", "users:write"
  description String?

  rolePermissions RolePermission[]

  createdAt   DateTime @default(now())
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// PHASE 2: EMPLOYEE PORTAL MODELS
// -----------------------------------------------------------------------------

model Attendance {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  checkInAt    DateTime
  checkOutAt   DateTime?
  totalMinutes Int?
  requiredDailyMinutes Int?
  status       String    @default("PRESENT") // PRESENT, HALF_DAY, LATE, NOT_STARTED, IN_PROGRESS, COMPLETE, INCOMPLETE, ABSENT, ON_LEAVE
  notes        String?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date]) // Prevent duplicate attendance for the same day
  @@index([userId])
  @@index([date])
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status       String    @default("TODO")   // TODO, IN_PROGRESS, BLOCKED, COMPLETED
  dueDate      DateTime?
  assignedDate DateTime  @default(now())
  
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  comments     TaskComment[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  
  @@index([taskId])
  @@index([userId])
}

model WorkReport {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  
  summary         String
  tasksCompleted  String?
  workPerformed   String
  challenges      String?
  nextSteps       String?
  hoursWorked     Float?
  
  status          String   @default("SUBMITTED") // SUBMITTED, REVIEWED
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model LeaveRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  leaveType    String   // SICK, CASUAL, ANNUAL, UNPAID
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  reason       String
  
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // TASK_ASSIGNED, LEAVE_APPROVED, ANNOUNCEMENT, SYSTEM
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  // Optional URL to redirect to
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  publishedAt DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}

model Document {
  id           String   @id @default(cuid())
  title        String
  category     String   // COMPANY_POLICY, GUIDELINE, FORM
  fileUrl      String
  
  uploadedById String
  uploadedBy   User     @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, ON_HOLD
  startDate   DateTime?
  endDate     DateTime?

  members     ProjectMember[]
  tasks       Task[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("MEMBER") // MANAGER, MEMBER

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

// -----------------------------------------------------------------------------
// PHASE 4: EXECUTIVE & GOVERNANCE MODELS
// -----------------------------------------------------------------------------

model ExecutiveProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responsibilityProfile String   // TECHNOLOGY, OPERATIONS, BUSINESS_GROWTH, FULL
  departmentScope       String?  // Optional JSON array or comma-separated string
  projectScope          String?  // Optional JSON array or comma-separated string

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ApprovalRequest {
  id            String    @id @default(cuid())
  requestType   String    // HIGH_PRIVILEGE_ROLE_ASSIGNMENT, SENSITIVE_PERMISSION_CHANGE, EMPLOYEE_STATUS_EXCEPTION, HIGH_IMPACT_PROJECT_CHANGE, SENSITIVE_EXPORT, ORGANIZATIONAL_SETTING_CHANGE
  requestedById String
  requestedBy   User      @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  
  decidedById   String?
  decidedBy     User?     @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reason        String?
  metadata      Json?
  
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([status])
  @@index([requestedById])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String   // LOGIN_SUCCESS, LOGIN_FAILED, ROLE_CHANGED, PERMISSION_CHANGED, SENSITIVE_EXPORT, SUSPICIOUS_ACCESS
  ipAddress String?
  userAgent String?
  details   Json?

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model OrganizationSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedById String?

  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// PHASE 6: SHARED ADVANCED INFRASTRUCTURE MODELS
// -----------------------------------------------------------------------------

model EmailLog {
  id          String   @id @default(cuid())
  toEmail     String
  templateKey String
  subject     String
  status      String   @default("SENT") // SENT, FAILED
  error       String?
  metadata    Json?

  sentAt      DateTime @default(now())

  @@index([toEmail])
  @@index([templateKey])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  subject     String
  htmlBody    String
  textBody    String
  variables   Json?    // Array of allowed variable names
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reminder {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    @default("CUSTOM") // TASK, LEAVE, APPROVAL, DOCUMENT, CUSTOM
  title         String
  description   String?
  dueAt         DateTime
  status        String    @default("PENDING") // PENDING, COMPLETED
  relatedEntity Json?
  completedAt   DateTime?

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([dueAt])
  @@index([status])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  jobType     String    // NOTIFICATION_SEND, EMAIL_RETRY, REMINDER_DELIVERY, ANNOUNCEMENT_SCHEDULE, DOCUMENT_EXPIRY
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  payload     Json?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?

  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([jobType])
}

model AutomationWorkflow {
  id          String    @id @default(cuid())
  name        String
  triggerType String    // TASK_OVERDUE, LEAVE_SUBMITTED, DOCUMENT_EXPIRING
  conditions  Json?
  actions     Json?
  isActive    Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  executions  AutomationExecution[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AutomationExecution {
  id           String             @id @default(cuid())
  automationId String
  automation   AutomationWorkflow @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggerEvent String
  status       String             @default("SUCCESS") // SUCCESS, FAILED
  dedupKey     String?
  result       Json?

  executedAt   DateTime           @default(now())

  @@index([automationId])
  @@index([dedupKey])
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  timezone           String   @default("UTC")
  theme              String   @default("dark")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// PHASE 5: CRM & LEAD MANAGEMENT MODELS
// -----------------------------------------------------------------------------

model Lead {
  id                  String   @id @default(cuid())
  leadCode            String   @unique
  name                String
  email               String
  phone               String?
  companyName         String?
  website             String?
  serviceInterest     String?
  message             String?
  source              String   @default("WEBSITE_CONTACT") // WEBSITE_CONTACT, CONSULTATION, REFERRAL, SOCIAL_MEDIA, CAMPAIGN, MANUAL, PARTNER, OTHER
  campaign            String?
  status              String   @default("NEW") // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED, NURTURE
  qualificationStatus String   @default("UNQUALIFIED") // QUALIFIED, UNQUALIFIED, IN_PROGRESS
  
  // Qualification Details
  budget              Float?
  timeline            String?
  businessNeed        String?
  decisionMakerKnown  Boolean  @default(false)
  qualificationNotes  String?

  // Duplicate Tracking
  isDuplicate         Boolean  @default(false)
  duplicateReason     String?

  ownerId             String?
  owner               User?    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  convertedClientId   String?
  convertedClient     CrmClient? @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)

  activities          LeadActivity[]
  followUps           FollowUp[]
  opportunities       Opportunity[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([email])
  @@index([leadCode])
}

model LeadActivity {
  id            String       @id @default(cuid())
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  clientId      String?
  client        CrmClient?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  actorId       String?
  actor         User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  
  type          String       // LEAD_CREATED, LEAD_ASSIGNED, STATUS_CHANGED, NOTE_ADDED, CALL_RECORDED, MEETING_RECORDED, FOLLOWUP_CREATED, FOLLOWUP_COMPLETED, OPPORTUNITY_CREATED, PROPOSAL_SENT, DEAL_WON, DEAL_LOST, CLIENT_CONVERTED
  title         String
  notes         String?
  metadata      Json?

  createdAt     DateTime     @default(now())

  @@index([leadId])
  @@index([opportunityId])
  @@index([clientId])
  @@index([actorId])
}

model FollowUp {
  id            String       @id @default(cuid())
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  clientId      String?
  client        CrmClient?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assignedToId  String
  assignedTo    User         @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  dueAt         DateTime
  type          String       @default("CALL") // CALL, EMAIL, MEETING, WHATSAPP, DEMO, PROPOSAL_FOLLOWUP, GENERAL
  notes         String?
  status        String       @default("UPCOMING") // UPCOMING, DUE, OVERDUE, COMPLETED
  completedAt   DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([assignedToId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([status])
  @@index([dueAt])
}

model PipelineStage {
  id          String        @id @default(cuid())
  name        String
  key         String        @unique // QUALIFIED, DISCOVERY, PROPOSAL, NEGOTIATION, WON, LOST
  order       Int           @default(0)
  probability Int           @default(50)
  description String?

  opportunities Opportunity[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Opportunity {
  id                String         @id @default(cuid())
  opportunityCode   String         @unique
  leadId            String?
  lead              Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId          String?
  client            CrmClient?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name              String
  description       String?
  value             Float          @default(0)
  currency          String         @default("INR")
  probability       Int            @default(50)
  expectedCloseDate DateTime?
  stage             String         @default("QUALIFIED") // QUALIFIED, DISCOVERY, PROPOSAL, NEGOTIATION, WON, LOST

  stageId           String?
  pipelineStage     PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  ownerId           String?
  owner             User?          @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  lossReason        String?

  proposals         Proposal[]
  activities        LeadActivity[]
  followUps         FollowUp[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([ownerId])
  @@index([leadId])
  @@index([clientId])
  @@index([stage])
}

model Proposal {
  id                String      @id @default(cuid())
  proposalNumber    String      @unique
  opportunityId     String
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  title             String
  amount            Float
  currency          String      @default("INR")
  status            String      @default("DRAFT") // DRAFT, READY, SENT, ACCEPTED, REJECTED, EXPIRED
  sentAt            DateTime?
  validUntil        DateTime?
  documentReference String?

  createdById       String?
  createdBy         User?       @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([opportunityId])
  @@index([status])
}

model CrmClient {
  id          String   @id @default(cuid())
  clientCode  String   @unique
  companyName String
  contactName String
  email       String
  phone       String?
  website     String?
  industry    String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, ONBOARDING

  ownerId     String?
  owner       User?    @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  leads       Lead[]
  opportunities Opportunity[]
  activities  LeadActivity[]
  followUps   FollowUp[]
  contacts    ClientContact[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([email])
  @@index([clientCode])
}

model ClientContact {
  id        String    @id @default(cuid())
  clientId  String
  client    CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId])
}



