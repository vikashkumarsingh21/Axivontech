generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client/employee"
}

datasource db {
  provider = "postgresql"
  url      = env("EMPLOYEE_DATABASE_URL")
}

model QaIssue {
  id               String   @id @default(cuid())
  partnerProjectId String
//   partnerProject   PartnerProject @relation("PartnerProjectQaIssues", fields: [partnerProjectId], references: [id], onDelete: Cascade)

  title            String
//   description      String   @db.Text
  status           String   @default("OPEN") // OPEN, IN_PROGRESS, FIXED, RETEST, PASSED, FAILED, CLOSED
  severity         String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  reporterId       String
//   reporter         User     @relation("QaIssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  assignedToId     String?
//   assignedTo       User?    @relation("QaIssueAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolvedAt       DateTime?
//   resolutionNotes  String?  @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([partnerProjectId])
  @@index([status])
}

model Attendance {
  id                   String    @id @default(cuid())
  userId               String
//   user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
//   date                 DateTime  @db.Date
  checkInAt            DateTime
  checkOutAt           DateTime?
  grossMinutes         Int?      @default(0)
  breakMinutes         Int?      @default(0)
  netMinutes           Int?      @default(0)
  totalMinutes         Int? // Legacy alias for netMinutes
  requiredDailyMinutes Int?      @default(480)
  remainingMinutes     Int?      @default(0)
  lateMinutes          Int?      @default(0)
  earlyExitMinutes     Int?      @default(0)
  isLate               Boolean   @default(false)
  isEarlyExit          Boolean   @default(false)
  status               String    @default("PRESENT") // PRESENT, HALF_DAY, LATE, NOT_STARTED, IN_PROGRESS, COMPLETE, INCOMPLETE, ABSENT, ON_LEAVE, HOLIDAY, WEEKLY_OFF
  completionStatus     String    @default("INCOMPLETE") // COMPLETE, INCOMPLETE, ON_LEAVE, HOLIDAY, WEEKLY_OFF, HALF_DAY
  emailAlertSent       Boolean   @default(false)
  notes                String?

  breaks         AttendanceBreak[]
  regularization RegularizationRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

//   @@unique([userId, date]) // Prevent duplicate attendance for the same day
  @@index([userId])
//   @@index([date])
  @@index([status])
  @@index([completionStatus])
}

model AttendanceBreak {
  id              String     @id @default(cuid())
  attendanceId    String
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?       @default(0)
  type            String     @default("LUNCH") // LUNCH, TEA, PERSONAL, SHORT_BREAK, OTHER
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attendanceId])
}

model AttendancePolicy {
  id                        String  @id @default(cuid())
  workWindowStart           String  @default("08:00") // 08:00 AM
  workWindowEnd             String  @default("19:00") // 07:00 PM
  defaultRequiredMinutes    Int     @default(480) // 8 Hours = 480 Mins
  graceMinutes              Int     @default(15)
  cutoffTime                String  @default("19:00") // 07:00 PM
  weeklyOffDays             Json? // e.g. [0, 6] (Sunday, Saturday)
  enableIncompleteAlerts    Boolean @default(true)
  allowRemoteRegularization Boolean @default(true)
  updatedById               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegularizationRequest {
  id                String      @id @default(cuid())
  attendanceId      String?     @unique
  attendance        Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  userId            String
//   user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
//   date              DateTime    @db.Date
  requestedCheckIn  DateTime
  requestedCheckOut DateTime
  requestedBreaks   Json?
  reason            String
  status            String      @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  reviewedById      String?
//   reviewedBy        User?       @relation("RegularizationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes       String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
//   @@index([date])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
//   date        DateTime @unique @db.Date
  isOptional  Boolean  @default(false)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

//   @@index([date])
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  partnerProjectId String?
//   partnerProject   PartnerProject? @relation("PartnerProjectTasks", fields: [partnerProjectId], references: [id], onDelete: SetNull)
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status       String    @default("TODO") // TODO, IN_PROGRESS, BLOCKED, COMPLETED
  dueDate      DateTime?
  assignedDate DateTime  @default(now())

  userId String
//   user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model TaskComment {
  id      String @id @default(cuid())
  content String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
//   user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

model WorkReport {
  id     String   @id @default(cuid())
  userId String
//   user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
//   date   DateTime @db.Date

  summary        String
  tasksCompleted String?
  workPerformed  String
  challenges     String?
  nextSteps      String?
  hoursWorked    Float?

  status String @default("SUBMITTED") // SUBMITTED, REVIEWED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

//   @@unique([userId, date])
  @@index([userId])
//   @@index([date])
}

model LeaveRequest {
  id     String @id @default(cuid())
  userId String
//   user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveType String // SICK, CASUAL, ANNUAL, UNPAID
//   startDate DateTime @db.Date
//   endDate   DateTime @db.Date
  reason    String

  status String @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Announcement {
  id            String    @id @default(cuid())
  title         String
  content       String
  priority      String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status        String    @default("PUBLISHED") // DRAFT, SCHEDULED, PUBLISHED, ARCHIVED, EXPIRED
  audienceType  String    @default("ALL") // ALL, DEPARTMENT, ROLE, PROJECT, USERS
  audienceScope String? // department name, role name, project id, or json array
  publishAt     DateTime  @default(now())
  publishedAt   DateTime  @default(now())
  expiresAt     DateTime?

  createdById String?
//   createdBy   User?   @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@index([status])
  @@index([audienceType])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ON_HOLD
  startDate   DateTime?
  endDate     DateTime?

  members ProjectMember[]
  tasks   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  projectId String
  userId    String
  role      String @default("MEMBER") // MANAGER, MEMBER

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
//   user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model ExecutiveProfile {
  id                    String  @id @default(cuid())
  userId                String  @unique
//   user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  responsibilityProfile String // TECHNOLOGY, OPERATIONS, BUSINESS_GROWTH, FULL
  departmentScope       String? // Optional JSON array or comma-separated string
  projectScope          String? // Optional JSON array or comma-separated string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalRequest {
  id            String @id @default(cuid())
  requestType   String // HIGH_PRIVILEGE_ROLE_ASSIGNMENT, SENSITIVE_PERMISSION_CHANGE, EMPLOYEE_STATUS_EXCEPTION, HIGH_IMPACT_PROJECT_CHANGE, SENSITIVE_EXPORT, ORGANIZATIONAL_SETTING_CHANGE
  requestedById String
//   requestedBy   User   @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  decidedById String?
//   decidedBy   User?   @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  status   String  @default("PENDING") // PENDING, APPROVED, REJECTED
  reason   String?
  metadata Json?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([status])
  @@index([requestedById])
}

model Reminder {
  id            String    @id @default(cuid())
  userId        String
//   user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    @default("CUSTOM") // TASK, LEAVE, APPROVAL, DOCUMENT, CUSTOM
  title         String
  description   String?
  dueAt         DateTime
  status        String    @default("PENDING") // PENDING, COMPLETED
  relatedEntity Json?
  completedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([dueAt])
  @@index([status])
}

model AutomationWorkflow {
  id          String  @id @default(cuid())
  name        String
  triggerType String // TASK_OVERDUE, LEAVE_SUBMITTED, DOCUMENT_EXPIRING
  conditions  Json?
  actions     Json?
  isActive    Boolean @default(true)
  createdById String?
//   createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  executions AutomationExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationExecution {
  id           String             @id @default(cuid())
  automationId String
  automation   AutomationWorkflow @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggerEvent String
  status       String             @default("SUCCESS") // SUCCESS, FAILED
  dedupKey     String?
  result       Json?

  executedAt DateTime @default(now())

  @@index([automationId])
  @@index([dedupKey])
}

