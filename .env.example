# -----------------------------------------------------------------------------
# Axivon Technologies — Production Environment Configuration Template
# COPY TO .env AND FILL REAL CREDENTIALS IN DEPLOYMENT HOSTING ENVIRONMENT
# NEVER COMMIT ACTUAL CREDENTIALS OR REAL DATABASE STRINGS TO GIT.
# -----------------------------------------------------------------------------

# Environment & Application Mode
NODE_ENV="production" # "development" | "staging" | "production"
PORT=3000

# Primary Managed Database (Neon PostgreSQL)
# Always use connection pooling URL in production with sslmode=require
DATABASE_URL="postgresql://user:password@neon-host-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://user:password@neon-host.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication & Session Key (Must be at least 32 random characters long)
SESSION_SECRET="change_me_in_production_minimum_32_characters_random_string_key"

# Email Provider Configuration (Resend API or Custom Webhook)
RESEND_API_KEY="re_123456789_placeholder"
RESEND_FROM="Axivon Notifications <notifications@axivontech.in>"
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""

# Object Storage (AWS S3 / Cloudflare R2 / DigitalOcean Spaces)
STORAGE_PROVIDER="S3" # "S3" | "LOCAL"
STORAGE_BUCKET="axivon-production-documents"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY_ID="AKIA_PLACEHOLDER_KEY"
STORAGE_SECRET_ACCESS_KEY="secret_key_placeholder"

# Security & CORS Origins (Comma-separated)
ALLOWED_ORIGINS="https://axivontech.in,https://app.axivontech.in,https://admin.axivontech.in"

# Background Automations & Scheduled Job Worker (Bearer Token)
CRON_SECRET="change_me_to_a_secure_random_string_for_cron_triggers"

# Public Application URLs
NEXT_PUBLIC_APP_URL="https://axivontech.in"

# External Integrations (Optional)
GOOGLE_SHEETS_LEAD_WEBHOOK_URL="" # Optional: Google Apps Script Webhook URL for lead backup

# Telemetry & Monitoring (Sentry / Datadog)
SENTRY_DSN=""
NEXT_PUBLIC_ANALYTICS_ID=""

# Cloudflare Turnstile Anti-Bot & CAPTCHA Configuration
# Public site key rendered in browser widget (Managed Challenge mode)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA" # Replace with real Cloudflare site key in production
# Private secret key used ONLY for server-side siteverify verification (NEVER expose to client)
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA" # Replace with real Cloudflare secret key in production
